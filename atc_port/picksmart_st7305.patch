@@ -26,17 +33,24 @@ int epd_ble_handle_write(void *p)
 
 	ASSERT_MIN_LEN(payload_len, 1);
 
+	if (tag_lock_command(payload, payload_len))
+		return 0;
+	if (!tag_lock_allows_changes())
+		return 0;  // locked: only 10 / 11 (unlock) are accepted
+
 	switch (payload[0])
 	{
 	// Clear EPD display.
 	case 0x00:
 		ASSERT_MIN_LEN(payload_len, 2);
+		epd_custom_image = 1;
 		memset(epd_buffer, payload[1], sizeof(epd_buffer));
 		ble_set_connection_speed(40);
