diff --git a/Firmware/src/tag_lock.c b/Firmware/src/tag_lock.c
new file mode 100644
index 0000000..4ae5857
--- /dev/null
+++ b/Firmware/src/tag_lock.c
@@ -0,0 +1,325 @@
+// Password lock: see tag_lock.h.
+#include "tag_lock.h"
+
+#ifdef TAG_LOCK_HOST_TEST
+#include "tag_lock_host.h"
+#else
+#include "tl_common.h"
+#include "drivers.h"
+#include "time.h"
+#endif
+
+typedef struct {
+	uint32_t magic;
+	uint32_t seq;          // the newer of the two sectors' records wins
+	uint8_t key[16];
+	uint8_t salt[16];      // random, chosen by the app when it locks the tag (not secret)
+	uint8_t check[32];     // ~(key, salt): a half-written record is never taken as a key
+} tag_lock_record_t;
+
+#define REC_FREE 0     // sector erased
+#define REC_OK 1
+#define REC_BAD 2      // our record, half written -> stay locked (fail closed)
+
+RAM static uint8_t lock_key[16];
+RAM static uint8_t lock_salt[16];
+RAM static uint32_t lock_seq;
+RAM static uint32_t lock_addr;           // sector holding the current record
+RAM static uint8_t lock_has_key;
+RAM static uint8_t lock_open;            // unlocked in this connection
+RAM static uint8_t lock_challenge[16];
+RAM static uint8_t lock_challenge_ok;   // a challenge is waiting for its answer
+RAM static uint8_t lock_session[16];    // the challenge that unlocked this connection
+RAM static uint8_t lock_failures;        // wrong answers in this connection
+RAM static uint8_t lock_total_failures;  // since the last right answer (kept across connections)
+RAM static uint32_t lock_last_failure;   // get_time() of the last wrong answer
+RAM uint8_t tag_lock_status[2];         // what reading the picture characteristic returns
+
+extern unsigned char epd_screen_window[];
+
+/* ---------------- AES-128 encryption (FIPS-197), small software version ---- */
+static const uint8_t sbox[256] = {
+0x63,0x7c,0x77,0x7b,0xf2,0x6b,0x6f,0xc5,0x30,0x01,0x67,0x2b,0xfe,0xd7,0xab,0x76,
+0xca,0x82,0xc9,0x7d,0xfa,0x59,0x47,0xf0,0xad,0xd4,0xa2,0xaf,0x9c,0xa4,0x72,0xc0,
+0xb7,0xfd,0x93,0x26,0x36,0x3f,0xf7,0xcc,0x34,0xa5,0xe5,0xf1,0x71,0xd8,0x31,0x15,
+0x04,0xc7,0x23,0xc3,0x18,0x96,0x05,0x9a,0x07,0x12,0x80,0xe2,0xeb,0x27,0xb2,0x75,
+0x09,0x83,0x2c,0x1a,0x1b,0x6e,0x5a,0xa0,0x52,0x3b,0xd6,0xb3,0x29,0xe3,0x2f,0x84,
+0x53,0xd1,0x00,0xed,0x20,0xfc,0xb1,0x5b,0x6a,0xcb,0xbe,0x39,0x4a,0x4c,0x58,0xcf,
+0xd0,0xef,0xaa,0xfb,0x43,0x4d,0x33,0x85,0x45,0xf9,0x02,0x7f,0x50,0x3c,0x9f,0xa8,
+0x51,0xa3,0x40,0x8f,0x92,0x9d,0x38,0xf5,0xbc,0xb6,0xda,0x21,0x10,0xff,0xf3,0xd2,
+0xcd,0x0c,0x13,0xec,0x5f,0x97,0x44,0x17,0xc4,0xa7,0x7e,0x3d,0x64,0x5d,0x19,0x73,
+0x60,0x81,0x4f,0xdc,0x22,0x2a,0x90,0x88,0x46,0xee,0xb8,0x14,0xde,0x5e,0x0b,0xdb,
+0xe0,0x32,0x3a,0x0a,0x49,0x06,0x24,0x5c,0xc2,0xd3,0xac,0x62,0x91,0x95,0xe4,0x79,
+0xe7,0xc8,0x37,0x6d,0x8d,0xd5,0x4e,0xa9,0x6c,0x56,0xf4,0xea,0x65,0x7a,0xae,0x08,
+0xba,0x78,0x25,0x2e,0x1c,0xa6,0xb4,0xc6,0xe8,0xdd,0x74,0x1f,0x4b,0xbd,0x8b,0x8a,
+0x70,0x3e,0xb5,0x66,0x48,0x03,0xf6,0x0e,0x61,0x35,0x57,0xb9,0x86,0xc1,0x1d,0x9e,
+0xe1,0xf8,0x98,0x11,0x69,0xd9,0x8e,0x94,0x9b,0x1e,0x87,0xe9,0xce,0x55,0x28,0xdf,
+0x8c,0xa1,0x89,0x0d,0xbf,0xe6,0x42,0x68,0x41,0x99,0x2d,0x0f,0xb0,0x54,0xbb,0x16};
+
+static uint8_t xtime(uint8_t x) { return (uint8_t)((x << 1) ^ ((x & 0x80) ? 0x1b : 0)); }
+
+void tag_lock_aes128(const uint8_t key[16], const uint8_t in[16], uint8_t out[16])
+{
+	uint8_t s[16], k[16], t[16];
+	uint8_t rcon = 1;
+	int i, round;
+	memcpy(k, key, 16);
+	for (i = 0; i < 16; i++)
+		s[i] = in[i] ^ k[i];
+	for (round = 1; round <= 10; round++)
+	{
+		// next round key
+		k[0] ^= sbox[k[13]] ^ rcon;
+		k[1] ^= sbox[k[14]];
+		k[2] ^= sbox[k[15]];
+		k[3] ^= sbox[k[12]];
+		for (i = 4; i < 16; i++)
+			k[i] ^= k[i - 4];
+		rcon = xtime(rcon);
+		// SubBytes + ShiftRows (state is column-major: s[col*4 + row])
+		for (i = 0; i < 16; i++)
+			t[i] = sbox[s[(i + 4 * (i & 3)) & 15]];
+		// MixColumns (not in the last round)
+		if (round < 10)
+		{
+			for (i = 0; i < 16; i += 4)
+			{
+				uint8_t a0 = t[i], a1 = t[i + 1], a2 = t[i + 2], a3 = t[i + 3];
+				uint8_t all = a0 ^ a1 ^ a2 ^ a3;
+				t[i] = a0 ^ all ^ xtime(a0 ^ a1);
+				t[i + 1] = a1 ^ all ^ xtime(a1 ^ a2);
+				t[i + 2] = a2 ^ all ^ xtime(a2 ^ a3);
+				t[i + 3] = a3 ^ all ^ xtime(a3 ^ a0);
+			}
+		}
+		for (i = 0; i < 16; i++)
+			s[i] = t[i] ^ k[i];
+	}
+	memcpy(out, s, 16);
+	memset(k, 0, sizeof(k));
+	memset(s, 0, sizeof(s));
+	memset(t, 0, sizeof(t));
+}
+
+/* ---------------- key storage ---------------------------------------------- */
+static void update_status(void)
+{
+	tag_lock_status[0] = 0x03;  // firmware v3: keeps pictures + password lock
+	tag_lock_status[1] = tag_lock_state();
+}
+
+static int read_record(uint32_t addr, tag_lock_record_t *r)
+{
+	int i, blank = 1, ok;
+	flash_read_page(addr, sizeof(*r), (uint8_t *)r);
+	for (i = 0; i < (int)sizeof(*r); i++)
+		if (((uint8_t *)r)[i] != 0xFF)
+			blank = 0;
+	if (blank || r->magic != TAG_LOCK_MAGIC)
+		return REC_FREE;  // erased, or something else's data (never one of our records)
+	ok = 1;
+	for (i = 0; i < 16 && ok; i++)
+		if ((uint8_t)(r->key[i] ^ r->check[i]) != 0xFF || (uint8_t)(r->salt[i] ^ r->check[16 + i]) != 0xFF)
+			ok = 0;
+	return ok ? REC_OK : REC_BAD;
+}
+
+static void load_key(void)
+{
+	tag_lock_record_t a, b;
+	int ra = read_record(TAG_LOCK_ADDR, &a);
+	int rb = read_record(TAG_LOCK_ADDR2, &b);
+	tag_lock_record_t *use = 0;
+	if (ra == REC_OK && (rb != REC_OK || a.seq >= b.seq))
+	{
+		use = &a;
+		lock_addr = TAG_LOCK_ADDR;
+	}
+	else if (rb == REC_OK)
+	{
+		use = &b;
+		lock_addr = TAG_LOCK_ADDR2;
+	}
+	if (use)
+	{
+		lock_has_key = 1;
+		lock_seq = use->seq;
+		memcpy(lock_key, use->key, 16);
+		memcpy(lock_salt, use->salt, 16);
+	}
+	else if (ra == REC_BAD || rb == REC_BAD)
+	{
+		// damaged record and no good one: stay locked with a key nobody knows
+		// (./unlock_usb.sh clears it over the USB-UART adapter)
+		lock_has_key = 1;
+		lock_seq = 0;
+		lock_addr = TAG_LOCK_ADDR;
+		generateRandomNum(16, lock_key);
+		memset(lock_salt, 0, 16);
+	}
+	else
+	{
+		lock_has_key = 0;
+		lock_seq = 0;
+		lock_addr = TAG_LOCK_ADDR2;  // so the first key goes to TAG_LOCK_ADDR
+		memset(lock_key, 0, 16);
+		memset(lock_salt, 0, 16);
+	}
+	memset(&a, 0, sizeof(a));
+	memset(&b, 0, sizeof(b));
+}
+
+// Write the new record into the other sector, check it, and only then erase
+// the old one: a power cut at any point leaves either the old or the new key.
+static int store_key(const uint8_t *key, const uint8_t *salt)
+{
+	tag_lock_record_t r;
+	uint32_t old = lock_has_key ? lock_addr : 0;
+	uint32_t dst = (lock_addr == TAG_LOCK_ADDR) ? TAG_LOCK_ADDR2 : TAG_LOCK_ADDR;
+	int i, ok;
+	r.magic = TAG_LOCK_MAGIC;
+	r.seq = lock_seq + 1;
+	for (i = 0; i < 16; i++)
+	{
+		r.key[i] = key[i];
+		r.salt[i] = salt[i];
+		r.check[i] = ~key[i];
+		r.check[16 + i] = ~salt[i];
+	}
+	flash_erase_sector(dst);
+	flash_write_page(dst, sizeof(r), (uint8_t *)&r);
+	ok = read_record(dst, &r) == REC_OK && memcmp(r.key, key, 16) == 0 && memcmp(r.salt, salt, 16) == 0;
+	memset(&r, 0, sizeof(r));
+	if (!ok)
+	{
+		flash_erase_sector(dst);  // keep the old key (or none) exactly as it was
+		return 0;
+	}
+	if (old)
+		flash_erase_sector(old);
+	load_key();
+	return 1;
+}
+
+static void erase_key(void)
+{
+	flash_erase_sector(TAG_LOCK_ADDR);
+	flash_erase_sector(TAG_LOCK_ADDR2);
+	load_key();
+}
+
+void tag_lock_init(void)
+{
+	load_key();
+	tag_lock_connection_changed();
+}
+
+void tag_lock_connection_changed(void)
+{
+	lock_open = 0;
+	lock_challenge_ok = 0;
+	lock_failures = 0;  // lock_total_failures is kept: it slows down guessing across connections
+	memset(lock_challenge, 0, 16);
+	memset(lock_session, 0, 16);
+	update_status();
+}
+
+uint8_t tag_lock_state(void)
+{
+	if (!lock_has_key)
+		return TAG_LOCK_NONE;
+	return lock_open ? TAG_LOCK_OPEN : TAG_LOCK_LOCKED;
+}
+
+int tag_lock_allows_changes(void)
+{
+	return !lock_has_key || lock_open;
+}
+
+static int same16(const uint8_t *a, const uint8_t *b)
+{
+	uint8_t d = 0;
+	int i;
+	for (i = 0; i < 16; i++)
+		d |= a[i] ^ b[i];
+	return d == 0;
+}
+
+static int cooling_down(void)
+{
+	// after 6 wrong answers (in any number of connections), one try per 30 s
+	return lock_total_failures >= 6 && (uint32_t)(get_time() - lock_last_failure) < 30;
+}
+
+int tag_lock_command(const uint8_t *payload, unsigned int len)
+{
+	uint8_t buf[16];
+	int i;
+	if (len < 1)
+		return 0;
+	switch (payload[0])
+	{
+	case 0x10: // new challenge: window = 10 state challenge[16] salt[16]
+		generateRandomNum(16, lock_challenge);
+		lock_challenge_ok = lock_failures < 3 && !cooling_down();
+		epd_screen_window[0] = 0x10;
+		epd_screen_window[1] = tag_lock_state();
+		if (lock_challenge_ok)
+			memcpy(epd_screen_window + 2, lock_challenge, 16);
+		else
+			memset(epd_screen_window + 2, 0, 16);  // no tries left now: wait / reconnect
+		memcpy(epd_screen_window + 18, lock_salt, 16);
+		break;
+	case 0x11: // answer
+		if (len >= 17 && lock_has_key && lock_challenge_ok)
+		{
+			tag_lock_aes128(lock_key, lock_challenge, buf);
+			if (same16(buf, payload + 1))
+			{
+				lock_open = 1;
+				lock_total_failures = 0;
+				memcpy(lock_session, lock_challenge, 16);
+			}
+			else
+			{
+				lock_open = 0;  // a wrong answer always leaves the tag locked
+				lock_failures++;
+				if (lock_total_failures < 255)
+					lock_total_failures++;
+				lock_last_failure = get_time();
+			}
+		}
+		lock_challenge_ok = 0;  // one try per challenge
+		memset(lock_challenge, 0, 16);
+		break;
+	case 0x12: // store a key: 12 key[16] salt[16]
+		if (len >= 33)
+		{
+			if (!lock_has_key)
+			{
+				if (store_key(payload + 1, payload + 17))
+					lock_open = 1;  // whoever set it is unlocked for the rest of this connection
+				memset(lock_session, 0, 16);
+			}
+			else if (lock_open)
+			{
+				for (i = 0; i < 16; i++)
+					buf[i] = lock_session[i] ^ 0x5A;
+				tag_lock_aes128(lock_key, buf, buf);
+				for (i = 0; i < 16; i++)
+					buf[i] ^= payload[1 + i];
+				store_key(buf, payload + 17);  // on failure the old key stays
+			}
+		}
+		break;
+	case 0x13: // remove the key
+		if (lock_has_key && lock_open)
+			erase_key();
+		break;
+	default:
+		return 0;
+	}
+	memset(buf, 0, sizeof(buf));
+	update_status();
+	return 1;
+}
diff --git a/Firmware/src/tag_lock.h b/Firmware/src/tag_lock.h
new file mode 100644
index 0000000..cb6ed6a
--- /dev/null
+++ b/Firmware/src/tag_lock.h
@@ -0,0 +1,41 @@
+#pragma once
+// Password lock for the tag (Tag Designer project).
+//
+// When a key is stored, every write that changes the tag (pictures, settings,
+// clock, Bluetooth firmware updates) is refused until the app proves it knows
+// the key in this connection:
+//   write 10            -> the tag makes a fresh random 16-byte challenge and
+//                          puts "10 state challenge[16] salt[16]" in the screen
+//                          window (read it from the screen characteristic 4b646064).
+//                          The challenge is all zeros when no try is allowed now.
+//   write 11 resp[16]   -> resp must be AES-128(key, challenge). One try per
+//                          challenge; 3 wrong answers end tries until reconnect;
+//                          after 6 wrong answers in a row (any connections) only
+//                          one try per 30 s. A wrong answer also re-locks.
+//   write 12 k[16] s[16]-> store a new key with its salt s. With no key yet: k is
+//                          the key. Once unlocked: k = newkey XOR AES-128(key, challenge ^ 5A..5A).
+//   write 13            -> remove the key (only once unlocked).
+// Reading the picture characteristic gives "03 state": state 0 = no password,
+// 1 = locked, 2 = unlocked in this connection.
+// The unlock lasts until the connection ends. Keys live in flash sectors
+// 0x7A000/0x7B000 (written new-then-old, so a power cut keeps one valid key; a
+// damaged record keeps the tag locked). Recovery without the key: erase both
+// sectors over SWire (./unlock_usb.sh).
+#include <stdint.h>
+
+#define TAG_LOCK_ADDR 0x7A000   /* two sectors: the newer valid record is the key */
+#define TAG_LOCK_ADDR2 0x7B000
+#define TAG_LOCK_MAGIC 0x4B434F4Cu  /* "LOCK" */
+
+#define TAG_LOCK_NONE 0
+#define TAG_LOCK_LOCKED 1
+#define TAG_LOCK_OPEN 2
+
+void tag_lock_init(void);
+void tag_lock_connection_changed(void);   // call on connect and on disconnect
+int tag_lock_allows_changes(void);         // 1 if writes may change the tag
+uint8_t tag_lock_state(void);
+// handles 10..13 on the picture characteristic; returns 1 if it was one of them
+int tag_lock_command(const uint8_t *payload, unsigned int len);
+extern uint8_t tag_lock_status[2];  // "03 state": the picture characteristic's value
+void tag_lock_aes128(const uint8_t key[16], const uint8_t in[16], uint8_t out[16]);
