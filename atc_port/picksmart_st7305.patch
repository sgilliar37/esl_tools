diff --git a/Firmware/src/lcd_st7305.c b/Firmware/src/lcd_st7305.c
new file mode 100644
index 0000000..f036767
--- /dev/null
+++ b/Firmware/src/lcd_st7305.c
@@ -0,0 +1,183 @@
+#include <stdint.h>
+#include "tl_common.h"
+#include "main.h"
+#include "drivers.h"
+#include "lcd_st7305.h"
+
+#if BOARD_PICKSMART_ST7305
+
+// Set to 1 if the picture comes out as a negative (black/white swapped).
+#ifndef LCD_INVERT
+#define LCD_INVERT 0
+#endif
+
+// Physical layout of the controller RAM (from the stock firmware):
+// 125 row addresses x 2 lines = 250 lines (long side)
+// 11 column addresses x 12 px = 132 px (short side, 122 on the glass)
+#define LCD_ROW_ADDRS 125
+#define LCD_BYTES_PER_ROW 33
+#define LCD_VISIBLE_H 122
+
+RAM static uint8_t lcd_initialised = 0; // kept in retention RAM across deep sleep
+
+_attribute_ram_code_ static void pin_out(GPIO_PinTypeDef pin, int level, GPIO_PullTypeDef pull)
+{
+    gpio_set_func(pin, AS_GPIO);
+    gpio_write(pin, level);
+    gpio_set_input_en(pin, 0);
+    gpio_set_output_en(pin, 1);
+    gpio_setup_up_down_resistor(pin, pull);
+}
+
+_attribute_ram_code_ void lcd_st7305_gpio_init(void)
+{
+    // Pull-ups on POWER and RESET hold them high while the chip is in deep
+    // sleep (the stock firmware does the same), so the LCD keeps its image.
+    pin_out(LCD_POWER, 1, PM_PIN_PULLUP_10K);
+    pin_out(LCD_RESET, 1, PM_PIN_PULLUP_10K);
+    pin_out(LCD_CS, 1, PM_PIN_PULLUP_1M);
+    pin_out(LCD_DC, 0, PM_PIN_PULLDOWN_100K);
+    pin_out(LCD_CLK, 0, PM_PIN_PULLDOWN_100K);
+    pin_out(LCD_MOSI, 0, PM_PIN_PULLDOWN_100K);
+
+    gpio_set_func(LCD_TE, AS_GPIO);
+    gpio_set_output_en(LCD_TE, 0);
+    gpio_set_input_en(LCD_TE, 1);
+    gpio_setup_up_down_resistor(LCD_TE, PM_PIN_PULLDOWN_100K);
+}
+
+_attribute_ram_code_ static void spi_byte(uint8_t v)
+{
+    for (int i = 0; i < 8; i++)
+    {
+        gpio_write(LCD_CLK, 0);
+        gpio_write(LCD_MOSI, v & 0x80);
+        v <<= 1;
+        gpio_write(LCD_CLK, 1);
+    }
+    gpio_write(LCD_CLK, 0);
+}
+
+_attribute_ram_code_ static void lcd_cmd(uint8_t cmd, const uint8_t *data, int len)
+{
+    gpio_write(LCD_CS, 0);
+    gpio_write(LCD_DC, 0);
+    spi_byte(cmd);
+    gpio_write(LCD_DC, 1);
+    for (int i = 0; i < len; i++)
+        spi_byte(data[i]);
+    gpio_write(LCD_CS, 1);
+}
+
+#define CMD(c, ...)                                     \
+    do                                                  \
+    {                                                   \
+        static const uint8_t d_[] = {0, ##__VA_ARGS__}; \
+        lcd_cmd(c, d_ + 1, sizeof(d_) - 1);             \
+    } while (0)
+
+_attribute_ram_code_ static void lcd_init_controller(void)
+{
+    // Hardware reset: high 10 ms, low 50 ms, high 10 ms (stock timings)
+    gpio_write(LCD_RESET, 1);
+    WaitMs(10);
+    gpio_write(LCD_RESET, 0);
+    WaitMs(50);
+    gpio_write(LCD_RESET, 1);
+    WaitMs(10);
+
+    CMD(0xD6, 0x17, 0x02);       // NVM load control
+    CMD(0xD1, 0x01);             // booster enable
+    CMD(0xC0, 0x0E, 0x05);       // gate voltage
+    CMD(0xC1, 0x41, 0x41, 0x41, 0x41); // VSH
+    CMD(0xC2, 0x32, 0x32, 0x32, 0x32); // VSL
+    CMD(0xC4, 0x4B, 0x4B, 0x4B, 0x4B);
+    CMD(0xC5, 0x00, 0x00, 0x00, 0x00);
+    CMD(0xD8, 0xA6, 0xE9);       // oscillator
+    CMD(0xB2, 0x11);             // frame rate
+    CMD(0xB3, 0xE5, 0xF6, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45); // HPM gate EQ
+    CMD(0xB4, 0x05, 0x46, 0x77, 0x77, 0x77, 0x77, 0x76, 0x45);             // LPM gate EQ
+    CMD(0xB7, 0x13);             // source EQ
+    CMD(0xB0, 0x3F);             // gate line setting
+    CMD(0x11);                   // sleep out
+    WaitMs(120);
+    CMD(0xC9, 0x00);             // source voltage select
+    CMD(0xC7, 0xC1, 0x41, 0x26); // ultra low power code
+    CMD(0x36, 0x00);             // memory data access control
+    CMD(0x3A, 0x11);             // data format
+    CMD(0xB9, 0x20);             // source setting
+    CMD(0xB8, 0x25);             // panel setting
+    CMD(0x21);                   // display inversion on (as stock)
+    CMD(0x2A, 0x19, 0x23);       // column address 0x19..0x23
+    CMD(0x2B, 0x00, 0x7C);       // row address 0..124
+    CMD(0x35, 0x00);             // TE on
+    CMD(0xD0, 0xFF);             // auto power down
+    CMD(0x39);                   // low power (idle) mode
+    CMD(0x29);                   // display on
+}
+
+// Is image pixel (x = 0..249 along the long side, y = 0..121) white?
+static inline int img_white(const uint8_t *image, int x, int y)
+{
+    return image[(249 - x) * 16 + (y >> 3)] & (0x80 >> (y & 7));
+}
+
+_attribute_ram_code_ void lcd_st7305_display(const uint8_t *image)
+{
+    lcd_st7305_gpio_init();
+    if (!lcd_initialised)
+    {
+        lcd_init_controller();
+        lcd_initialised = 1;
+    }
+
+    CMD(0x2A, 0x19, 0x23);
+    CMD(0x2B, 0x00, 0x7C);
+
+    gpio_write(LCD_CS, 0);
+    gpio_write(LCD_DC, 0);
+    spi_byte(0x2C); // memory write
+    gpio_write(LCD_DC, 1);
+
+    // RAM line ly (0..249) shows image column x = 249 - ly; RAM pixel lx
+    // (0..131) shows image row y = 131 - lx. lx 0..9 are off the glass.
+    // Each byte covers 4 pixels x 2 lines: bit 7 = (lx, even line),
+    // bit 6 = (lx, odd line), bit 5 = (lx+1, even line) ...
+    for (int ra = 0; ra < LCD_ROW_ADDRS; ra++)
+    {
+        int x0 = 249 - (ra * 2);
+        int x1 = x0 - 1;
+        for (int b = 0; b < LCD_BYTES_PER_ROW; b++)
+        {
+            uint8_t v = 0;
+            for (int i = 0; i < 4; i++)
+            {
+                int y = 131 - (b * 4 + i);
+                int w0 = 1, w1 = 1;
+                if (y < LCD_VISIBLE_H)
+                {
+                    w0 = img_white(image, x0, y) != 0;
+                    w1 = img_white(image, x1, y) != 0;
+                }
+                v |= (w0 << (7 - 2 * i)) | (w1 << (6 - 2 * i));
+            }
+#if LCD_INVERT
+            v = ~v;
+#endif
+            spi_byte(v);
+        }
+    }
+    gpio_write(LCD_CS, 1);
+    lcd_st7305_sleep_pins();
+}
+
+// Leave the bus idle and quiet between updates. POWER and RESET stay high.
+_attribute_ram_code_ void lcd_st7305_sleep_pins(void)
+{
+    gpio_write(LCD_CS, 1);
+    gpio_write(LCD_CLK, 0);
+    gpio_write(LCD_MOSI, 0);
+    gpio_write(LCD_DC, 0);
+}
+
+#endif
